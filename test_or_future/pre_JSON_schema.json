{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Nango-neo pre_JSON_schema",
    "description": "this is test",
    "type": "object",
    "properties": {
        "words": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": { "type": "integer" },
                    "datetime": {
                        "type": "string",
                        "format": "datetime",
                        "description": "format is RFC3339"
                    },
                    "word": { "type": "string" },
                    "category": { "type": "string" },
                    "fieldTag": { "type": "string" },
                    "eraTag": { "type": "string" },
                    "reading": { "type": "string" },
                    "kanji": { "type": "string" },
                    "english": { "type": "string" },
                    "column": { "type": "string" },
                    "memo": { "type": "string" },
                    "gemini_note": { "type": "string" },
                    "other_tags": {
                        "type": "array",
                        "items": { "type": "string" }
                    },
                    "meaning": {
                        "type": "object",
                        "properties": {
                            "definition": { "type": "string" },
                            "background": { "type": "string" },
                            "nuance": { "type": "string" },
                            "examples": {
                                "type": "array",
                                "items": { "type": "string" }
                            },
                            "synonyms": {
                                "type": "array",
                                "items": { "type": "string" }
                            }
                        }
                    }
                }
            }
        }
    }
}
