{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nango-neo pre_JSON_schema",
  "description": "this is test",
  "type": "object",
  "required": ["words"],
  "properties": {
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["word", "meanings"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "integer" },
          "datetime": {
            "type": "string",
            "format": "datetime",
            "description": "format is RFC3339"
          },
          "word": { "type": "string" },
          "category": { "type": "string" },
          "eraTag": { "type": "string" },
          "reading": { "type": "string" },
          "kanji": { "type": "string" },
          "english": { "type": "string" },
          "column": { "type": "string" },
          "memo": { "type": "string" },
          "gemini_note": { "type": "string" },
          "other_tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "meanings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["definition"],
              "properties": {
                "definition": { "type": "string" },
                "background": { "type": "string" },
                "nuance": { "type": "string" },
                "fieldTag": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "examples": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "synonyms": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
